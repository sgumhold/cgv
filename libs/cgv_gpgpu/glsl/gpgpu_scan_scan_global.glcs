#version 430

#include "gpgpu_scan_common.glcs"

#ifdef CGV_USE_SNIPPETS


layout(local_size_x = LOCAL_SIZE_X) in;
void main() {
	int tid = int(gl_LocalInvocationID.x);
	const int n = int(u_args.num_group_sums);
	
	// Perform standard work-efficient up-sweep reduction (after Blelloch 1990).
	int offset = 1;
	for(int d = n >> 1; d > 0; d >>= 1) {
		barrier();

		for(int idx = tid; idx < d; idx += int(gl_WorkGroupSize.x)) {
			int ai = offset * (idx + idx + 1) - 1;
			int bi = offset * (idx + idx + 2) - 1;

			b_group_sums[bi] = operation(b_group_sums[bi], b_group_sums[ai]);
		}
		offset += offset;
	}

	// The down-sweep uses the partial results from the upsweep-phase but produces an inclusive prefix scan.
	// This avoids the need for restting the last sum to the neutral element and enables using arbitrary
	// binary operations for the scan.
    for(int d = 2; d <= n; d <<= 1) {
        offset >>= 1;
        barrier();

		for(int idx = tid; idx < d - 1; idx += int(gl_WorkGroupSize.x)) {
            int ai = offset * (idx + idx + 2) - 1;
            int bi = offset * (idx + idx + 3) - 1;
            
            // Check boundaries to avoid writing outside the active stride steps
            if(bi < n)
				b_group_sums[bi] = operation(b_group_sums[bi], b_group_sums[ai]);
        }
    }
}

#endif // CGV_USE_SNIPPETS

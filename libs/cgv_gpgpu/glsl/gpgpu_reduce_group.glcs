#version 460

#include "gpgpu_args.glcs"

#include "sbb_reduce.glcs"

#ifdef CGV_USE_SNIPPETS
layout(local_size_x = LOCAL_SIZE_X) in;

layout(std430, binding = 0) buffer input_buffer {
	value_type data_in[];
};

layout(std430, binding = 1) buffer output_buffer {
	value_type data_out[];
};

uniform uint u_input_begin;
uniform uint u_output_begin;
uniform uint u_count;
uniform value_type u_init;

shared value_type s_data[gl_WorkGroupSize.x];

value_type operation(value_type lhs, value_type rhs) {
	//$cgv::operation
}

CGV_SBB_GROUP_REDUCE(group_reduce, LOCAL_SIZE_X, s_data, operation)

void main() {
	uint tid = gl_LocalInvocationID.x;
	uint gid = gl_GlobalInvocationID.x;
	uint grid_size = gl_WorkGroupSize.x * gl_NumWorkGroups.x;

	uint index = gid;
	if(index < u_count)
		s_data[tid] = data_in[u_input_begin + index];

	index += grid_size;

	while(index < u_count) {
		s_data[tid] = operation(s_data[tid], data_in[u_input_begin + index]);
		index += grid_size;
	}

	// If just one group is active a single thread needs to include the initial value in the reduction.
	if(tid == 0 && gl_NumWorkGroups.x == 1)
		s_data[0] = operation(u_init, s_data[0]);
	
	barrier();
	
	// Perform partial reduction in the last work group if it is not fully utilized.
	if(gl_WorkGroupID.x == gl_NumWorkGroups.x - 1 && u_count < gl_NumWorkGroups.x * gl_WorkGroupSize.x) {
		uint remainder = u_count - gl_WorkGroupSize.x  * (u_count / gl_WorkGroupSize.x);
		group_reduce(int(tid), int(remainder));
	} else {
		group_reduce(int(tid));
	}

	// Write the result of this group to global memory.
	if(tid == 0)
		data_out[u_output_begin + gl_WorkGroupID.x] = s_data[0];
}
#endif

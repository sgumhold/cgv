projectGUID="3AD44ED0-8186-4f28-A19B-F0C26CA40596";
addProjectDeps=["cgv_render", "cgv_gui", "cgv_utils", "cgv_type", "cgv_reflect", "glsu","cgv_data","cgv_base", "cgv_signal", "cgv_gl", "cgv_post"];

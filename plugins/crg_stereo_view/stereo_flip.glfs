#version 430

layout (binding = 0) uniform sampler2D color_tex;
layout (binding = 1) uniform sampler2D depth_tex;

#define VSPLIT 0
#define HSPLIT 1
#define ANAGLYPH 2

uniform int stereo_mode = 0; // 0 .. vsplit, 1 .. hsplit, 2 .. anaglyph, 3 .. quad buffer
uniform vec3 anaglyph_left_mask;
uniform vec3 anaglyph_right_mask;
uniform bvec2 vflip = { false, false };
uniform bvec2 hflip = { false, false };
uniform ivec2 res;

in vec2 texcoord_fs;

layout(location = 0) out vec4 frag_color;

// map coord range from [0,1] to [0.5/res, 1-0.5/res]
vec2 correct_tc(in vec2 tc)
{
	return vec2(
		((float(res.x)-1.0)*tc.x+0.5)/float(res.x),
		((float(res.y)-1.0)*tc.y+0.5)/float(res.y)
	);
}

void main()
{
	vec2 tc = correct_tc(texcoord_fs);
	vec2 tc2 = tc;
	switch (stereo_mode) {
	case VSPLIT :
		if (tc.x < 0.5) { // left viewport
			if (vflip[0])
				tc.x = 0.5-tc.x;
			if (hflip[0])
				tc.y = 1.0-tc.y;
		} else {          // right viewport
			if (vflip[1])
				tc.x = 1.0-tc.x;
			if (hflip[1])
				tc.y = 1.0-tc.y;
		}
		frag_color = texture(color_tex, tc);
		gl_FragDepth = texture(depth_tex, tc).r;
		break;
	case HSPLIT :
		if (tc.y < 0.5) { // bottom viewport
			if (vflip[0])
				tc.x = 1.0-tc.x;
			if (hflip[0])
				tc.y = 0.5-tc.y;
		} else {          // top viewport
			if (vflip[1])
				tc.x = 1.0-tc.x;
			if (hflip[1])
				tc.y = 1.0-tc.y;
		}
		frag_color = texture(color_tex, tc);
		gl_FragDepth = texture(depth_tex, tc).r;
		break;
	case ANAGLYPH :
		if (vflip[0])
			tc.x = 1.0-tc.x;
		if (hflip[0])
			tc.y = 1.0-tc.y;
		if (vflip[1])
			tc2.x = 1.0-tc2.x;
		if (hflip[1])
			tc2.y = 1.0-tc2.y;
		frag_color = vec4(anaglyph_left_mask*texture(color_tex, tc).rgb + anaglyph_right_mask*texture(color_tex, tc2).rgb, 1.0);
		gl_FragDepth = min(texture(depth_tex, tc).r, texture(depth_tex, tc2).r);
		break;
	default:
		frag_color = texture(color_tex, texcoord_fs);
		gl_FragDepth = texture(depth_tex, texcoord_fs).r;
		break;
	}
}
